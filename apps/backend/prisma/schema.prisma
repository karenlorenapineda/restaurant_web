generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A minimal real model keeps the first Prisma client and migration path valid.
// Domain entities will be added after the restaurant workflows are approved.
// ---------------- USER & AUTHENTICATION ----------------
model UserRole {
  id          Int     @id @default(autoincrement()) @map("role_id")
  name        String  @map("role_name") @db.VarChar(255)
  description String? @db.Text
  users       User[]

  @@map("user_roles")
}

model Language {
  id    Int    @id @default(autoincrement()) @map("language_id")
  code  String @map("language_code") @db.VarChar(10)
  name  String @map("language_name") @db.VarChar(255)
  users User[]

  @@map("languages")
}

model User {
  id             Int       @id @default(autoincrement()) @map("user_id")
  email          String    @unique @db.VarChar(255)
  passwordHash   String?   @map("password_hash") @db.VarChar(255)
  oauthProvider  String?   @map("oauth_provider") @db.VarChar(50)
  oauthId        String?   @map("oauth_id") @db.VarChar(255)
  profilePicture String?   @map("profile_picture") @db.VarChar(255)
  roleId         Int       @map("role_id")
  languageId     Int       @map("language_id")
  isActive       Boolean   @default(true) @map("is_active")
  emailVerified  Boolean   @default(false) @map("email_verified")
  lastLogin      DateTime? @map("last_login") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  role     UserRole  @relation(fields: [roleId], references: [id])
  language Language  @relation(fields: [languageId], references: [id])
  employee Employee?

  sentFriendships     Friendship[]   @relation("FriendshipRequester")
  receivedFriendships Friendship[]   @relation("FriendshipAddressee")
  sentMessages        ChatMessage[]  @relation("MessageSender")
  receivedMessages    ChatMessage[]  @relation("MessageReceiver")
  notifications       Notification[]

  @@map("users")
}

// ---------------- RESTAURANT & EMPLOYEES ----------------

model Restaurant {
  id       Int     @id @default(autoincrement()) @map("restaurant_id")
  name     String  @db.VarChar(255)
  address  String  @db.Text
  isActive Boolean @default(true) @map("is_active")

  employees Employee[]
  orders    Order[]

  @@map("restaurants")
}

model EmployeePosition {
  id          Int        @id @default(autoincrement()) @map("position_id")
  name        String     @map("position_name") @db.VarChar(255)
  description String?    @db.Text
  employees   Employee[]

  @@map("employee_positions")
}

model Employee {
  id              Int       @id @default(autoincrement()) @map("employee_id")
  userId          Int       @unique @map("user_id")
  firstName       String    @map("first_name") @db.VarChar(255)
  lastName        String    @map("last_name") @db.VarChar(255)
  phone           String?   @db.VarChar(255)
  restaurantId    Int       @map("restaurant_id")
  positionId      Int       @map("position_id")
  birthDate       DateTime  @map("birth_date") @db.Date
  hireDate        DateTime  @default(now()) @map("hire_date") @db.Timestamp(6)
  terminationDate DateTime? @map("termination_date") @db.Timestamp(6)
  isActive        Boolean   @default(true) @map("is_active")

  user       User             @relation(fields: [userId], references: [id])
  restaurant Restaurant       @relation(fields: [restaurantId], references: [id])
  position   EmployeePosition @relation(fields: [positionId], references: [id])
  orders     Order[]

  @@map("employees")
}

// ---------------- MENU & RECIPES ----------------

model MenuCategory {
  id          Int        @id @default(autoincrement()) @map("category_id")
  name        String     @db.VarChar(255)
  description String?    @db.Text
  items       MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id          Int     @id @default(autoincrement()) @map("item_id")
  name        String  @db.VarChar(255)
  imageUrl    String? @map("image_url") @db.VarChar(255)
  description String? @db.Text
  price       Decimal @db.Decimal(10, 2)
  categoryId  Int     @map("category_id")
  isAvailable Boolean @default(true) @map("is_available")

  category     MenuCategory  @relation(fields: [categoryId], references: [id])
  recipes      Recipe[]
  orderDetails OrderDetail[]

  @@index([categoryId])
  @@map("menu_items")
}

model UnitOfMeasure {
  id           Int          @id @default(autoincrement()) @map("unit_id")
  abbreviation String       @db.VarChar(10)
  name         String       @db.VarChar(50)
  ingredients  Ingredient[]

  @@map("units_of_measure")
}

model Ingredient {
  id           Int     @id @default(autoincrement()) @map("ingredient_id")
  name         String  @db.VarChar(255)
  unitId       Int     @map("unit_id")
  unitCost     Decimal @map("unit_cost") @db.Decimal(10, 2)
  currentStock Decimal @default(0.000) @map("current_stock") @db.Decimal(10, 3)

  unit    UnitOfMeasure @relation(fields: [unitId], references: [id])
  recipes Recipe[]

  @@map("ingredients")
}

model Recipe {
  id           Int     @id @default(autoincrement()) @map("recipe_id")
  itemId       Int     @map("item_id")
  ingredientId Int     @map("ingredient_id")
  quantity     Decimal @db.Decimal(10, 3)

  item       MenuItem   @relation(fields: [itemId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([itemId])
  @@map("recipes")
}

// ---------------- ORDERS & BILLING ----------------

model OrderStatus {
  id            Int                  @id @default(autoincrement()) @map("status_id")
  name          String               @db.VarChar(50)
  orders        Order[]
  statusHistory OrderStatusHistory[]

  @@map("order_statuses")
}

model Table {
  id          Int     @id @default(autoincrement()) @map("table_id")
  tableNumber String  @map("table_number") @db.VarChar(10)
  capacity    Int
  orders      Order[]

  @@map("tables")
}

model Order {
  id              Int      @id @default(autoincrement()) @map("order_id")
  tableId         Int?     @map("table_id")
  customerName    String?  @map("customer_name") @db.VarChar(255)
  customerAddress String?  @map("customer_address") @db.Text
  customerPhone   String?  @map("customer_phone") @db.VarChar(255)
  restaurantId    Int      @map("restaurant_id")
  employeeId      Int?     @map("employee_id")
  statusId        Int      @map("status_id")
  orderDate       DateTime @default(now()) @map("order_date") @db.Timestamp(6)
  total           Decimal  @default(0.00) @db.Decimal(10, 2)

  table         Table?               @relation(fields: [tableId], references: [id])
  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id])
  employee      Employee?            @relation(fields: [employeeId], references: [id])
  status        OrderStatus          @relation(fields: [statusId], references: [id])
  orderDetails  OrderDetail[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  bill          Bill?

  @@map("orders")
}

model OrderDetail {
  id        Int     @id @default(autoincrement()) @map("order_detail_id")
  orderId   Int     @map("order_id")
  itemId    Int     @map("item_id")
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  notes     String? @db.Text

  order Order    @relation(fields: [orderId], references: [id])
  item  MenuItem @relation(fields: [itemId], references: [id])

  @@index([orderId])
  @@index([itemId])
  @@map("order_details")
}

model OrderStatusHistory {
  id         Int      @id @default(autoincrement()) @map("history_id")
  orderId    Int      @map("order_id")
  statusId   Int      @map("status_id")
  statusDate DateTime @default(now()) @map("status_date") @db.Timestamp(6)

  order  Order       @relation(fields: [orderId], references: [id])
  status OrderStatus @relation(fields: [statusId], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

model PaymentMethod {
  id       Int       @id @default(autoincrement()) @map("payment_method_id")
  name     String    @db.VarChar(50)
  payments Payment[]

  @@map("payment_methods")
}

model Payment {
  id              Int      @id @default(autoincrement()) @map("payment_id")
  orderId         Int      @map("order_id")
  paymentMethodId Int      @map("payment_method_id")
  amount          Decimal  @db.Decimal(10, 2)
  paymentDate     DateTime @default(now()) @map("payment_date") @db.Timestamp(6)

  order         Order         @relation(fields: [orderId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@map("payments")
}

model Bill {
  id            Int      @id @default(autoincrement()) @map("bill_id")
  orderId       Int      @unique @map("order_id")
  billNumber    String?  @unique @map("bill_number") @db.VarChar(50)
  issueDate     DateTime @default(now()) @map("issue_date") @db.Timestamp(6)
  customerTaxId String?  @map("customer_tax_id") @db.VarChar(50)
  taxableBase   Decimal  @map("taxable_base") @db.Decimal(10, 2)
  vatPercentage Decimal  @map("vat_percentage") @db.Decimal(10, 2)
  vatAmount     Decimal  @map("vat_amount") @db.Decimal(10, 2)
  totalBill     Decimal  @map("total_bill") @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id])

  @@map("bills")
}

// ---------------- SOCIAL & REAL-TIME ----------------

enum RequestStatus {
  pending
  approved
  rejected
}

model Friendship {
  id          Int           @id @default(autoincrement()) @map("friendship_id")
  requesterId Int           @map("requester_id")
  addresseeId Int           @map("addressee_id")
  status      RequestStatus @default(pending)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

model ChatMessage {
  id         Int      @id @default(autoincrement()) @map("message_id")
  senderId   Int      @map("sender_id")
  receiverId Int      @map("receiver_id")
  message    String   @db.Text
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamp(6)
  isRead     Boolean  @default(false) @map("is_read")

  sender   User @relation("MessageSender", fields: [senderId], references: [id])
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@map("chat_messages")
}

model Notification {
  id         Int      @id @default(autoincrement()) @map("notification_id")
  userId     Int      @map("user_id")
  actionType String?  @map("action_type") @db.VarChar(50)
  message    String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}
