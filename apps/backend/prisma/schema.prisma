generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A minimal real model keeps the first Prisma client and migration path valid.
// Domain entities will be added after the restaurant workflows are approved.
model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model RolesUsuario {
  RolID       Int     @id @default(autoincrement())
  NombreRol   String  @db.VarChar(255)
  Descripcion String? @db.Text

  usuarios Usuarios[]
}

model Idiomas {
  IdiomaID     Int    @id @default(autoincrement())
  CodigoIdioma String @db.VarChar(10)
  Idioma       String @db.VarChar(255)

  usuarios Usuarios[]
}

model Usuarios {
  UsuarioID       Int       @id @default(autoincrement())
  Email           String    @unique @db.VarChar(255)
  PasswordHash    String?   @db.VarChar(255)
  ProveedorOAuth  String?   @db.VarChar(50)
  OAuthID         String?   @db.VarChar(255)
  FotoPerfil      String?   @db.VarChar(255)
  RolID           Int
  IdiomaID        Int
  Activo          Boolean   @default(true)
  EmailVereficado Boolean   @default(false)
  UlitmoAcceso    DateTime? @db.Timestamp
  FechaCreacion   DateTime  @default(now()) @db.Timestamp

  rol    RolesUsuario @relation(fields: [RolID], references: [RolID])
  idioma Idiomas      @relation(fields: [IdiomaID], references: [IdiomaID])

  clientes             Clientes?
  empleados            Empleados?
  mensajeChatReceptor  MensajeChat[]    @relation("MensajesRecibidos")
  mensajeChatRemitente MensajeChat[]    @relation("MensajesEnviados")
  amigosSolcitud       Amigos[]         @relation("SolicitudesEnviadas")
  amigosReceptor       Amigos[]         @relation("SolicitudesRecibidas")
  notificaciones       Notificaciones[]
}

model Direcciones {
  DireccionID Int     @id @default(autoincrement())
  ClienteID   Int
  Calle       String  @db.VarChar(255)
  Numero      String  @db.VarChar(10)
  Puerta      String? @db.VarChar(10)
  Piso        String? @db.VarChar(10)
  Localidad   String  @db.VarChar(255)

  cliente Clientes @relation(fields: [ClienteID], references: [ClienteID])
}

model Clientes {
  ClienteID         Int       @id @default(autoincrement())
  UsuarioID         Int       @unique
  Nombre            String    @db.VarChar(255)
  Apellido          String    @db.VarChar(255)
  Telefono          String?   @db.VarChar(255)
  FechaNacimiento   DateTime  @db.Date
  FechaPrimerPedido DateTime? @db.Timestamp

  usuario Usuarios @relation(fields: [UsuarioID], references: [UsuarioID])

  direcciones        Direcciones[]
  pedidos            Pedidos[]
  resenasRestaurante ResenasRestaurante[]
}

model DireccionesRestaurante {
  DireccionID  Int     @id @default(autoincrement())
  Calle        String  @db.VarChar(255)
  Numero       String  @db.VarChar(10)
  Puerta       String? @db.VarChar(10)
  Piso         String? @db.VarChar(10)
  Localidad    String  @db.VarChar(255)
  CodigoPostal String? @db.VarChar(10)

  restaurantes Restaurantes?
}

model Restaurantes {
  RestauranteID Int     @id @default(autoincrement())
  Nombre        String  @db.VarChar(255)
  DireccionID   Int     @unique
  Activo        Boolean @default(true)

  direccion DireccionesRestaurante @relation(fields: [DireccionID], references: [DireccionID])

  empleados          Empleados[]
  pedidos            Pedidos[]
  resenasRestaurante ResenasRestaurante[]
}

model CargosEmpleado {
  CargoEmpleadoID Int     @id @default(autoincrement())
  NombreCargo     String  @db.VarChar(255)
  Descripcion     String? @db.Text

  empleados Empleados[]
}

model Empleados {
  EmpleadoID      Int       @id @default(autoincrement())
  UsuarioID       Int       @unique
  Nombre          String    @db.VarChar(255)
  Apellido        String    @db.VarChar(255)
  Telefono        String?   @db.VarChar(255)
  RestuaranteID   Int
  CargoEmpleadoID Int
  FechaNacimiento DateTime  @db.Date
  FechaIngreso    DateTime  @db.Timestamp
  FechaDespido    DateTime? @db.Timestamp
  Activo          Boolean   @default(true)

  usuario     Usuarios       @relation(fields: [UsuarioID], references: [UsuarioID])
  cargo       CargosEmpleado @relation(fields: [CargoEmpleadoID], references: [CargoEmpleadoID])
  restaurante Restaurantes   @relation(fields: [RestuaranteID], references: [RestauranteID])

  pedidos Pedidos[]
}

model CategoriasMenus {
  CategoriaID Int     @id @default(autoincrement())
  Nombre      String  @db.VarChar(255)
  Descripcion String? @db.Text

  itemsMenu ItemsMenu[]
}

model ItemsMenu {
  ItemID      Int     @id @default(autoincrement())
  Nombre      String  @db.VarChar(255)
  Imagen      String? @db.Text
  Descripcion String? @db.Text
  Precio      Decimal @db.Decimal(10, 2)
  CategoriaID Int
  Disponible  Boolean @default(true)

  categoria CategoriasMenus @relation(fields: [CategoriaID], references: [CategoriaID])

  recetas        Recetas[]
  detallesPedido DetallePedidos[]

  @@index([CategoriaID])
}

model UnidadesMedida {
  UnidadID    Int    @id @default(autoincrement())
  Abreviatura String @db.VarChar(10)
  Nombre      String @db.VarChar(255)

  insumos Insumos[]
}

model Insumos {
  InsumosID   Int     @id @default(autoincrement())
  Nombre      String  @db.VarChar(255)
  UnidadID    Int
  CostoUnidad Decimal @db.Decimal(10, 2)
  StockActual Decimal @default(0) @db.Decimal(10, 3)

  unidad UnidadesMedida @relation(fields: [UnidadID], references: [UnidadID])

  recetas Recetas[]
}

model Recetas {
  RecetaID  Int     @id @default(autoincrement())
  ItemID    Int
  InsumosID Int
  Cantidad  Decimal @db.Decimal(10, 3)

  item   ItemsMenu @relation(fields: [ItemID], references: [ItemID])
  insumo Insumos   @relation(fields: [InsumosID], references: [InsumosID])

  @@index([ItemID])
}

model EstadosPedido {
  EstadoID Int    @id @default(autoincrement())
  Nombre   String @db.VarChar(50)

  pedidos               Pedidos[]
  historialEstadoPedido HistorialEstadoPedido[]
}

model Mesas {
  MesaID    Int    @id @default(autoincrement())
  Numero    String @db.VarChar(10)
  Capacidad Int

  pedidos Pedidos[]
}

model Pedidos {
  PedidoID      Int      @id @default(autoincrement())
  MesaID        Int?
  ClienteID     Int
  RestauranteID Int
  EmpleadoID    Int
  EstadoID      Int
  FechaHora     DateTime @db.Timestamp
  Total         Decimal  @default(0) @db.Decimal(10, 2)

  mesa        Mesas?        @relation(fields: [MesaID], references: [MesaID])
  cliente     Clientes      @relation(fields: [ClienteID], references: [ClienteID])
  restaurante Restaurantes  @relation(fields: [RestauranteID], references: [RestauranteID])
  empleado    Empleados     @relation(fields: [EmpleadoID], references: [EmpleadoID])
  estado      EstadosPedido @relation(fields: [EstadoID], references: [EstadoID])

  detallePedidos        DetallePedidos[]
  pagos                 Pagos[]
  facturas              Facturas?
  historialEstadoPedido HistorialEstadoPedido[]
  mensajeChat           MensajeChat[]
}

model DetallePedidos {
  DetallePedidoID Int     @id @default(autoincrement())
  PedidoID        Int
  ItemID          Int
  Cantidad        Int     @default(1)
  PrecioUnitario  Decimal @db.Decimal(10, 2)
  Notas           String? @db.Text

  pedido Pedidos   @relation(fields: [PedidoID], references: [PedidoID])
  item   ItemsMenu @relation(fields: [ItemID], references: [ItemID])

  @@index([PedidoID, ItemID])
}

model HistorialEstadoPedido {
  HistorialID Int      @id @default(autoincrement())
  PedidoID    Int
  EstadoID    Int
  FechaHora   DateTime @default(now()) @db.Timestamp

  pedido Pedidos       @relation(fields: [PedidoID], references: [PedidoID])
  estado EstadosPedido @relation(fields: [EstadoID], references: [EstadoID])

  @@index([PedidoID])
}

model MetodosPago {
  MetodoID Int    @id @default(autoincrement())
  Nombre   String @db.VarChar(50)

  pagos Pagos[]
}

model Pagos {
  PagoID    Int      @id @default(autoincrement())
  PedidoID  Int
  MetodoID  Int
  Monto     Decimal  @db.Decimal(10, 2)
  FechaHora DateTime @default(now()) @db.Timestamp

  pedido Pedidos     @relation(fields: [PedidoID], references: [PedidoID])
  metodo MetodosPago @relation(fields: [MetodoID], references: [MetodoID])
}

model Facturas {
  FacturaID        Int      @id @default(autoincrement())
  PedidoId         Int      @unique
  NumeroFactura    String   @unique @db.VarChar(50)
  FechaEmision     DateTime @default(now()) @db.Timestamp
  ClienteDocumento String?  @db.VarChar(50)
  ClienteNombre    String?  @db.VarChar(255)
  ClienteDireccion String?  @db.Text
  BaseImponible    Decimal  @db.Decimal(10, 2)
  PorcentajeIVA    Decimal  @db.Decimal(10, 2)
  MontoIVA         Decimal  @db.Decimal(10, 2)
  TotalFactura     Decimal  @db.Decimal(10, 2)

  pedido Pedidos @relation(fields: [PedidoId], references: [PedidoID])
}

enum EstadosSolicitud {
  pending
  approved
  rejected
}

model Amigos {
  AmistadID          Int              @id @default(autoincrement())
  UsuarioSolicitudID Int
  UsuarioReceptorID  Int
  Estado             EstadosSolicitud @default(pending)
  FechaCreacion      DateTime         @default(now()) @db.Timestamp

  usuarioSolcitud Usuarios @relation("SolicitudesEnviadas", fields: [UsuarioSolicitudID], references: [UsuarioID])
  usuarioReceptor Usuarios @relation("SolicitudesRecibidas", fields: [UsuarioReceptorID], references: [UsuarioID])

  @@unique([UsuarioSolicitudID, UsuarioReceptorID])
}

model MensajeChat {
  MensajeID    Int      @id @default(autoincrement())
  RemintenteID Int
  ReceptorID   Int
  PedidoID     Int?
  Mensaje      String   @db.Text
  FechaHora    DateTime @default(now()) @db.Timestamp
  Leido        Boolean  @default(false)

  remitente Usuarios @relation("MensajesEnviados", fields: [RemintenteID], references: [UsuarioID])
  receptor  Usuarios @relation("MensajesRecibidos", fields: [ReceptorID], references: [UsuarioID])
  pedido    Pedidos? @relation(fields: [PedidoID], references: [PedidoID])

  @@index([PedidoID])
}

model Notificaciones {
  NotificacionID Int      @id @default(autoincrement())
  UsuarioID      Int
  TipoAccion     String?  @db.VarChar(50)
  Mensaje        String   @db.Text
  Leido          Boolean  @default(false)
  FechaHora      DateTime @default(now()) @db.Timestamp

  usuario Usuarios @relation(fields: [UsuarioID], references: [UsuarioID])

  @@index([UsuarioID])
}

model ResenasRestaurante {
  ResenaID      Int      @id @default(autoincrement())
  ClienteID     Int
  RestauranteID Int
  Calificacion  Int      @db.SmallInt
  Comentario    String?  @db.Text
  FechaHora     DateTime @default(now()) @db.Timestamp

  cliente     Clientes     @relation(fields: [ClienteID], references: [ClienteID])
  restaurante Restaurantes @relation(fields: [RestauranteID], references: [RestauranteID])

  @@unique([ClienteID, RestauranteID])
}
