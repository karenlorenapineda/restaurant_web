generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A minimal real model keeps the first Prisma client and migration path valid.
// Domain entities will be added after the restaurant workflows are approved.
model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
