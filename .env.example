# PostgreSQL
POSTGRES_DB=picasso
POSTGRES_USER=picasso
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://picasso:replace_with_a_long_random_password@database:5432/picasso?schema=public

# Public gateway ports
HTTP_PORT=80
HTTPS_PORT=443

# Backend
PORT=3000
NODE_ENV=production
